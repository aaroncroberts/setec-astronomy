# Local development secrets for Cloudflare Workers
# Copy this file to .dev.vars and fill in the values.
# .dev.vars is gitignored — never commit it.
#
# Usage: wrangler dev reads .dev.vars automatically.

# ── RSA private key for RS256 JWT signing ─────────────────────────────────────
# Generate a new key pair:
#   openssl genrsa -out private.pem 2048
#   cat private.pem   # paste the full PEM block below (including header/footer)
#
# Or use the test key from tests/unit/routes/token.test.ts for local dev only.
SIGNING_KEY_PRIVATE="-----BEGIN PRIVATE KEY-----
REPLACE_WITH_YOUR_RSA_PRIVATE_KEY_PEM
-----END PRIVATE KEY-----"

# ── Admin API bearer token ─────────────────────────────────────────────────────
# Any strong random string. Used to authenticate POST /admin/users and
# POST /admin/clients requests.
#   openssl rand -hex 32
ADMIN_API_KEY="replace-with-a-strong-random-secret"

# ── ISSUER override for local development ─────────────────────────────────────
# Overrides the ISSUER set in wrangler.toml [vars] for local dev only.
# Must match the URL your local Worker is reachable at.
ISSUER="http://localhost:8787"
